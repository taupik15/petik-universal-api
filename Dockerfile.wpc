# Experimental WPC profile for an environment with sufficient memory for Chromium.
# The regular Dockerfile remains the supported Render Free profile (BgUtils only).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DENO_NO_UPDATE_CHECK=1 \
    DENO_NO_PROMPT=1 \
    YOUTUBE_WPC_ENABLED=1 \
    YOUTUBE_POT_PROVIDER_MODE=wpc \
    YOUTUBE_WPC_BROWSER_PATH=/usr/bin/chromium \
    BGUTIL_POT_PROVIDER_ENABLED=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg chromium \
    && rm -rf /var/lib/apt/lists/* \
    && test -x /usr/bin/chromium

# Deno is retained for yt-dlp's YouTube JavaScript challenge solver.
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && test -x /usr/local/bin/deno \
    && deno --version \
    && deno eval 'const [major, minor] = Deno.version.deno.split(".").map(Number); if (major < 2 || (major === 2 && minor < 3)) { console.error("Deno >= 2.3.0 is required"); Deno.exit(1); }'

WORKDIR /app
COPY requirements.txt ./requirements.txt
COPY requirements-wpc.txt ./requirements-wpc.txt
RUN pip install --no-cache-dir -r requirements.txt -r requirements-wpc.txt \
    && pip uninstall -y bgutil-ytdlp-pot-provider
COPY app.py ./app.py
COPY pot_telemetry.py ./pot_telemetry.py

EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000}"]
